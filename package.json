{
  "name": "@scriptdude/pi-merger",
  "version": "0.1.1",
  "type": "module",
  "description": "pi extension: review, approve, merge and comment on open GitHub PRs from a full-screen TUI (via gh)",
  "keywords": ["pi-package", "pi-extension", "github", "pull-request", "code-review"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "author": "Dimitri Tholen",
  "repository": { "type": "git", "url": "git+https://github.com/dimitritholen/pi-merger.git" },
  "files": ["index.ts", "gh.ts", "diff.ts", "repos.ts", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test --experimental-strip-types diff.test.ts gh.test.ts repos.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "image": "https://raw.githubusercontent.com/dimitritholen/pi-merger/main/docs/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
